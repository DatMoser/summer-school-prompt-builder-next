# Local Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Backend Service Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# NextAuth Configuration (Required for Google OAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-local-secret-key

# Google OAuth & APIs (Required for YouTube integration)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Cloud (Optional fallbacks for backend service)
GOOGLE_CLOUD_PROJECT=your-project-id
GCS_BUCKET=your-bucket
VERTEX_AI_REGION=us-central1

# AI API Key (Should be configured on backend service)
# GEMINI_API_KEY - Not needed in frontend, handled by backend